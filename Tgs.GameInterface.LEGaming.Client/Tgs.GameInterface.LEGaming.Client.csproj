<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Version>1.0.2</Version>
		<Authors>Raypro</Authors>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-legaming</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-legaming.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<RootNamespace>Tgs.GameInterface.LEGaming.Client</RootNamespace>
		<PackageId>Tgs.GameInterface.LEGaming.Client</PackageId>
		<Title>Tgs.GameInterface.LEGaming.Client</Title>
		<Description>Tgs.GameInterface.LEGaming.Client</Description>
		<PackageTags>Tgs GameInterface LEGaming Client</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.63.0" />
		<PackageReference Include="Grpc.Net.ClientFactory" Version="2.63.0" />
		<PackageReference Include="Grpc.Tools" Version="2.64.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.7" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="..\Tgs.GameInterface.LEGaming\Protos\gameinterfacelegaming.proto">
			<Link>gameinterfacelegaming.proto</Link>
		</Protobuf>
	</ItemGroup>

</Project>
